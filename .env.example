# Copy to .env (gitignored) and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://glaka:glaka@localhost:5433/glaka

# Embeddings (local Ollama)
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# Chat model. Get a key at https://openrouter.ai/keys
LLM_PROVIDER=openrouter
CHAT_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_API_KEY=
# Free models (ids ending in ":free") need data collection allowed, because their
# hosts may train on prompts. Demo data only, never real customer messages:
#   CHAT_MODEL=nvidia/nemotron-3.5-super-vl:free
#   OPENROUTER_ALLOW_DATA_COLLECTION=true
OPENROUTER_ALLOW_DATA_COLLECTION=false
# For a local model instead: LLM_PROVIDER=ollama and CHAT_MODEL=llama3.1:8b
